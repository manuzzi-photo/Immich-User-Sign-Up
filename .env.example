# ============================================================================
# Immich Sign-Up webapp configuration
# ----------------------------------------------------------------------------
# Copy the relevant values into the SAME .env file used by your Immich stack
# (or a dedicated .env next to docker-compose.webapp.yml).
# ============================================================================

# Base URL of the Immich server as reachable from the webapp container.
# On the shared Docker network this is the service name + internal port.
IMMICH_API_URL=http://immich-server:2283

# Admin API key generated inside Immich:
#   Immich web app -> Account Settings -> API Keys -> New API Key
# It MUST belong to an administrator account (needed to create users and to
# read the user list). Keep it secret.
IMMICH_SIGNUP_API_KEY=replace-with-immich-admin-api-key

# Random secret used to sign admin session cookies and to encrypt pending
# passwords at rest. Generate one with, e.g.:  openssl rand -hex 32
SIGNUP_SESSION_SECRET=replace-with-a-long-random-string

# Default disk quota assigned to every new user, in bytes (5 GiB default).
DEFAULT_QUOTA_BYTES=5368709120

# Public URL where users reach Immich to sign in after registration (optional;
# shown as a convenience link after an auto-approved sign-up).
IMMICH_PUBLIC_URL=

# Set to 1 when the webapp is served over HTTPS (adds the Secure cookie flag).
SIGNUP_COOKIE_SECURE=0
