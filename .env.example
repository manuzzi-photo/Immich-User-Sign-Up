# ============================================================================
# Immich Sign-Up webapp configuration
# ----------------------------------------------------------------------------
# Copy the relevant values into the SAME .env file used by your Immich stack
# (or a dedicated .env next to docker-compose.webapp.yml).
# ============================================================================

# Base URL of the Immich server as reachable from the webapp container.
# On the shared Docker network this is the service name + internal port.
IMMICH_API_URL=http://immich-server:2283

# Immich release tag used by docker-compose.example.yml. This webapp is verified
# against v2.7.5; the app warns at startup if the connected Immich differs.
IMMICH_VERSION=v2.7.5

# Override the Immich version the webapp expects (defaults to 2.7.5). Only the
# startup compatibility check uses this; leave unset unless you know what you do.
# IMMICH_REQUIRED_VERSION=2.7.5

# Admin API key generated inside Immich:
#   Immich web app -> Account Settings -> API Keys -> New API Key
# It MUST belong to an administrator account (needed to create users and to
# read the user list). Keep it secret.
IMMICH_SIGNUP_API_KEY=replace-with-immich-admin-api-key

# Random secret used to sign admin session cookies and to encrypt pending
# passwords at rest. Generate one with, e.g.:  openssl rand -hex 32
SIGNUP_SESSION_SECRET=replace-with-a-long-random-string

# Default disk quota assigned to every new user, in bytes (5 GiB default).
DEFAULT_QUOTA_BYTES=5368709120

# Public URL where users reach Immich to sign in after registration. Shown as a
# convenience link after sign-up and used as the redirect target when an
# existing user logs in. For SSO this must be the Immich host on the shared
# parent domain, e.g. https://photos.example.com
IMMICH_PUBLIC_URL=

# Set to 1 when the webapp is served over HTTPS (adds the Secure cookie flag).
SIGNUP_COOKIE_SECURE=0

# ----------------------------------------------------------------------------
# Existing-user login / SSO (optional)
# ----------------------------------------------------------------------------
# When an existing user submits correct credentials on the registration form:
#  - SSO_ENABLED=true  -> set Immich's session cookies so the browser lands on
#                         Immich already authenticated. REQUIRES the webapp and
#                         Immich to share the same parent domain (see below) and
#                         a reverse proxy (subdomains, "Option A").
#  - SSO_ENABLED=false -> only validate the credentials and redirect the user to
#                         IMMICH_PUBLIC_URL (works with any deployment).
SSO_ENABLED=false

# Parent domain (eTLD+1) shared by the webapp and Immich, used as the cookie
# Domain for SSO. REQUIRED when SSO_ENABLED=true. Example with the webapp on
# signup.example.com and Immich on photos.example.com:
#   IMMICH_COOKIE_DOMAIN=.example.com
# NOTE: the Immich session cookie is then sent to ALL subdomains of this domain,
# so use a domain dedicated to Immich.
IMMICH_COOKIE_DOMAIN=
